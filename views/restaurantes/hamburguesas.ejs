<%- include("../partials/header") %>

<h2 class="text-center mb-4">🍔 Hamburguesas de <%= restaurante.nombre %></h2>
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% hamburguesas.forEach(burg => { %>
    <div class="col d-flex">
      <div class="card w-100">
        <img src="/uploads/<%= burg.imagen %>" class="card-img-top" alt="<%= burg.nombre %>">
        <div class="card-body text-center">
          <h5 class="card-title"><%= burg.nombre %></h5>
          <p><%= burg.descripcion %></p>
          <p>⭐ <%= burg.calificacion ? burg.calificacion.toFixed(1) : "Sin votos" %>/5</p>
          <form action="/hamburguesas/votar/<%= burg.id %>" method="POST">
            <select name="calificacion" class="form-select form-select-sm mb-2" required>
              <option value="">Votar</option>
              <% for(let i = 1; i <= 5; i++) { %>
                <option value="<%= i %>"><%= i %></option>
              <% } %>
            </select>
            <button type="submit" class="btn btn-success btn-sm">Enviar voto</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>
